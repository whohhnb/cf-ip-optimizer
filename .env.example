# 复制为 .env 后填写
# 面板对外域名（需已解析到本机公网 IP）
PILOT_DOMAIN=edgepilot.example.com
# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com
# 面板在反向代理后面时设为 true，否则日志与登录限流看到的是代理地址
# 直接用二进制对外提供服务（没有代理）时保持 false，否则 X-Forwarded-For 可被伪造
PILOT_TRUST_PROXY=false
# 用于 JWT 签名与 DNS 凭据加密，务必固定并妥善保存
# 生成：openssl rand -hex 32
PILOT_SECRET=
