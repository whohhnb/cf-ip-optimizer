# EdgePilot 环境变量模板
# 用法：复制为 .env 后按需修改。
# 二进制启动时会自动加载「工作目录」或「可执行文件同目录」下的 .env，
# 已经存在的环境变量优先（systemd 的 Environment= 会覆盖这里的值）。
# docker compose 同样会读取同目录下的 .env。

# ---------- 必填 ----------

# 面板对外域名，需已解析到本机公网 IP（Caddy 用它申请证书）
PILOT_DOMAIN=edgepilot.example.com

# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com

# JWT 签名与 DNS 凭据加密，务必固定并妥善保存；留空会自动生成并存到数据目录
# 生成：openssl rand -hex 32
PILOT_SECRET=

# ---------- 可选（下面是默认值，取消注释才生效）----------

# 监听地址
# PILOT_ADDR=:8080

# 数据目录。容器里是 /data，直接跑二进制默认 ./data
# PILOT_DATA_DIR=./data

# 对外地址，决定 Cookie 要不要加 Secure；留空则按请求推断
# PILOT_BASE_URL=https://edgepilot.example.com

# 面板在反向代理后面时设为 true，否则日志与登录限流看到的是代理地址
# 直接用二进制对外提供服务（前面没有代理）时保持 false，否则 X-Forwarded-For 可被伪造
# docker-compose 里已固定为 true，不需要在这里重复设置
# PILOT_TRUST_PROXY=false

# 日志级别：debug / info / warn / error。debug 会多输出扫描阶段与调度器巡检
# PILOT_LOG_LEVEL=info
