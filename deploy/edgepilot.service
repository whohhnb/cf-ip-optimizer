[Unit]
Description=EdgePilot 边缘优选调度
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 使用独立用户，且数据目录必须可写
User=edgepilot
Group=edgepilot
WorkingDirectory=/opt/edgepilot
Environment=PILOT_ADDR=:8080
Environment=PILOT_DATA_DIR=/opt/edgepilot/data
Environment=PILOT_BASE_URL=https://edgepilot.example.com
# 固定密钥：丢失后所有 DNS 凭据需要重新录入
Environment=PILOT_SECRET=请替换为 32 位以上随机字符串
Environment=TZ=Asia/Shanghai
# 也可以把配置写在 /opt/edgepilot/.env（二进制会自动加载，下面的 Environment= 优先）
ExecStart=/opt/edgepilot/edgepilot
Restart=on-failure
RestartSec=3

# 扫描需要大量并发连接
LimitNOFILE=65535

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/edgepilot/data

[Install]
WantedBy=multi-user.target
